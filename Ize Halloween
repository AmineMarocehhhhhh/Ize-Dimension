-- ================= State =================
local running = true
local totalKilled = 0

-- ================= Your exact loop =================
task.spawn(function()
    while true do
        if running then
            local folder = workspace:FindFirstChild("Folders")
            local monsters = folder and folder:FindFirstChild("Monsters")
            if monsters then
                local kids = monsters:GetChildren()
                if #kids > 0 then
                    local thisCycle = 0
                    for _, v in ipairs(kids) do
                        if v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Monster") and isnetworkowner(v.HumanoidRootPart) then
                            v.Monster.Health = 0
                            thisCycle = thisCycle + 1
                        end
                    end
                    if thisCycle > 0 then
                        totalKilled = totalKilled + thisCycle
                        status.Text = "Status: Killed " .. thisCycle .. " mobs"
                        killedCount.Text = "Killed: " .. totalKilled
                        status.TextColor3 = Color3.fromRGB(255, 0, 0)
                        task.wait(0.2)
                        status.TextColor3 = Color3.fromRGB(0, 255, 0)
                        status.Text = "Status: Running"
                    else
                        status.Text = "Status: Running"
                        status.TextColor3 = Color3.fromRGB(0, 255, 0)
                    end
                else
                    status.Text = "Status: No monsters"
                    status.TextColor3 = Color3.fromRGB(255, 255, 0)
                end
            else
                status.Text = "Status: No Monsters folder"
                status.TextColor3 = Color3.fromRGB(255, 255, 0)
            end
        else
            status.Text = "Status: Stopped"
            status.TextColor3 = Color3.fromRGB(255, 255, 0)
        end
        task.wait(0.5)
    end
end)

-- ================= Toggle =================
toggleBtn.MouseButton1Click:Connect(function()
    running = not running
    if running then
        toggleBtn.Text = "STOP"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        status.Text = "Status: Running"
        status.TextColor3 = Color3.fromRGB(0, 255, 0)
    else
        toggleBtn.Text = "START"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
        status.Text = "Status: Stopped"
        status.TextColor3 = Color3.fromRGB(255, 255, 0)
    end
end)
